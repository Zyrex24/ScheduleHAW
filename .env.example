# Core academic tools require no environment variables, API keys or accounts.
# Community Pulse stays off until backend role, RLS, limits and retention are verified.
NEXT_PUBLIC_COMMUNITY_PULSE_ENABLED=false
PULSE_DATABASE_URL=
PULSE_HASH_SECRET=
PULSE_HASH_KEY_VERSION=1
PULSE_RETENTION_VERIFIED=false
# Optional privileged connection for the operator-maintained hourly retention job.
# Never prefix credentials with NEXT_PUBLIC_.
